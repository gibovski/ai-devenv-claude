#!/usr/bin/env bash
# Starts the Docker Compose stack: base file plus what the apply engine wrote to /var/lib/devenv.
set -euo pipefail
STACK=/opt/devenv STATE=/var/lib/devenv
cd "$STACK"
[ -f compose.yaml ] || { echo "no compose.yaml yet"; exit 0; }
args=(--project-name devenv --project-directory "$STACK" -f compose.yaml)
[ -f "$STATE/compose.override.yaml" ] && args+=(-f "$STATE/compose.override.yaml")
[ -f "$STATE/stack.env" ] && args+=(--env-file "$STATE/stack.env")
exec docker compose "${args[@]}" up -d --remove-orphans
